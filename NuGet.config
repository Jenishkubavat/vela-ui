<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Ignore feeds configured on the developer's machine so every restore,
    local or CI, resolves packages from the same place.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
