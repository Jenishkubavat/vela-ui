<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    This project is the component registry. It is compiled and tested so every
    component is known to build, but it is never published as a package: the vela
    CLI copies these source files into the user's application instead.
  -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <!-- Styled components wrap these headless primitives; installed apps reference the package. -->
  <ItemGroup>
    <ProjectReference Include="..\Primitives\Vela.UI.Primitives.csproj" />
  </ItemGroup>

</Project>
