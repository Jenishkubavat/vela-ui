@namespace Vela.UI.Components
@*
    An Item's supporting text, cut to two lines. Links inside it are underlined.
*@

<p class="@ClassNames.Join(Classes, Class)"
   data-slot="item-description"
   @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    private const string Classes =
        "line-clamp-2 text-start text-body-sm text-fg-muted group-data-[size=xs]/item:text-caption " +
        "[&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-fg";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The description text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;p&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
