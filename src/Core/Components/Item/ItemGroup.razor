@namespace Vela.UI.Components
@*
    A list of Items (role="list"); give each Item role="listitem". The gap tightens for
    small items.
*@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="item-group"
     role="list"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes =
        "group/item-group flex w-full flex-col gap-4 has-data-[size=sm]:gap-2.5 has-data-[size=xs]:gap-2";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The items, with optional ItemSeparator lines between them.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
