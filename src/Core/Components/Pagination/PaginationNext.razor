@namespace Vela.UI.Components
@*
    The link to the next page: the Text label from the sm breakpoint up, plus a chevron.
    Its aria-label is "Go to next page"; pass your own to translate it.
*@

<PaginationLink aria-label="Go to next page"
                Size="ButtonSize.Default"
                Class="@ClassNames.Join("pe-2!", Class)"
                @attributes="AdditionalAttributes">
    <span class="hidden sm:block">@Text</span>
    <svg data-icon="inline-end" class="rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
    </svg>
</PaginationLink>

@code {
    /// <summary>
    /// The visible label. Defaults to "Next".
    /// </summary>
    [Parameter]
    public string Text { get; set; } = "Next";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Other attributes, such as <c>href</c> and <c>aria-label</c>, applied to the <c>&lt;a&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
