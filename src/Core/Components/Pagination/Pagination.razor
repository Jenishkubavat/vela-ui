@namespace Vela.UI.Components
@*
    A <nav> around page links: PaginationContent holds a PaginationItem per link. Its
    aria-label is "pagination"; pass your own to translate it or to tell two apart.
*@

<nav aria-label="pagination"
     class="@ClassNames.Join(Classes, Class)"
     data-slot="pagination"
     @attributes="AdditionalAttributes">
    @ChildContent
</nav>

@code {
    private const string Classes = "mx-auto flex w-full justify-center";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// A <see cref="PaginationContent"/>.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes, such as <c>aria-label</c>, applied to the <c>&lt;nav&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
