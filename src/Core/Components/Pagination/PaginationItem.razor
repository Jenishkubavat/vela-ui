@namespace Vela.UI.Components
@*
    One <li> in a PaginationContent, holding a link or an ellipsis.
*@

<li class="@Class"
    data-slot="pagination-item"
    @attributes="AdditionalAttributes">
    @ChildContent
</li>

@code {
    /// <summary>
    /// CSS classes for the <c>&lt;li&gt;</c>.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// A <see cref="PaginationLink"/>, <see cref="PaginationPrevious"/>,
    /// <see cref="PaginationNext"/>, or <see cref="PaginationEllipsis"/>.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;li&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
