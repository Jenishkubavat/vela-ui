@namespace Vela.UI.Components
@*
    The link to the previous page: a chevron, plus the Text label from the sm breakpoint up.
    Its aria-label is "Go to previous page"; pass your own to translate it.
*@

<PaginationLink aria-label="Go to previous page"
                Size="ButtonSize.Default"
                Class="@ClassNames.Join("ps-2!", Class)"
                @attributes="AdditionalAttributes">
    <svg data-icon="inline-start" class="rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
    </svg>
    <span class="hidden sm:block">@Text</span>
</PaginationLink>

@code {
    /// <summary>
    /// The visible label. Defaults to "Previous".
    /// </summary>
    [Parameter]
    public string Text { get; set; } = "Previous";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Other attributes, such as <c>href</c> and <c>aria-label</c>, applied to the <c>&lt;a&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
