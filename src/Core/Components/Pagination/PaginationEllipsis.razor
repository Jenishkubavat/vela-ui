@namespace Vela.UI.Components
@*
    Stands in for pages skipped between links. It's hidden from screen readers, since the
    page numbers around it already say where you are.
*@

<span class="@ClassNames.Join(Classes, Class)"
      aria-hidden="true"
      data-slot="pagination-ellipsis"
      @attributes="AdditionalAttributes">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="5" cy="12" r="1.75" />
        <circle cx="12" cy="12" r="1.75" />
        <circle cx="19" cy="12" r="1.75" />
    </svg>
</span>

@code {
    private const string Classes =
        "flex size-8 items-center justify-center text-fg-faint [&_svg:not([class*='size-'])]:size-4";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;span&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
