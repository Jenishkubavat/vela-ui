@namespace Vela.UI.Components
@* A decorative icon at the start of a Marker. Hidden from screen readers. *@

<span class="@ClassNames.Join(Classes, Class)"
      aria-hidden="true"
      data-slot="marker-icon"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private const string Classes = "size-4 shrink-0 [&_svg:not([class*='size-'])]:size-4";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The icon.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;span&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
