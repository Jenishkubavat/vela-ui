@namespace Vela.UI.Components
@* Stacks consecutive bubbles from the same sender. *@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="bubble-group"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes = "flex min-w-0 flex-col gap-2";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The bubbles.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the group's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
