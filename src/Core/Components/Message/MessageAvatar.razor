@namespace Vela.UI.Components
@*
    The sender's picture or initials, beside the message. It lines up with the last bubble,
    above the footer when there is one.
*@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="message-avatar"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes =
        "flex w-fit min-w-8 shrink-0 items-center justify-center self-end overflow-hidden rounded-full " +
        "bg-surface-raised group-has-data-[slot=message-footer]/message:-translate-y-8";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// An image or initials.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the avatar's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
