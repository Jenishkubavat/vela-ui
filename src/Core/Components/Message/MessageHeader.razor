@namespace Vela.UI.Components
@* Small print above the bubbles, such as the sender's name. *@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="message-header"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes =
        "flex max-w-full min-w-0 items-center px-3 text-caption text-fg-muted " +
        "group-has-data-[variant=ghost]/message:px-0";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The header text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the header's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
