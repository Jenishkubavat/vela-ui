@namespace Vela.UI.Components
@*
    Stacks several Fields into a form. It is also the size container that Responsive
    Fields measure, so they switch to a row when the group is wide enough.
*@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="field-group"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes =
        "group/field-group @container/field-group flex w-full flex-col gap-5 *:data-[slot=field-group]:gap-4";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The fields, field sets, and separators in the group.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the group's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
