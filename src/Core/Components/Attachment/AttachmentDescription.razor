@namespace Vela.UI.Components
@*
    An Attachment's details, such as its size, type, or why it failed.
*@

<span class="@ClassNames.Join(Classes, Class)"
      data-slot="attachment-description"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private const string Classes =
        "mt-0.5 block max-w-full min-w-0 truncate text-caption text-fg-muted " +
        "group-data-[state=error]/attachment:text-danger";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The details text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;span&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
