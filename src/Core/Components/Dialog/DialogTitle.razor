@namespace Vela.UI.Components
@using Vela.UI.Primitives
@*
    The dialog's title, which names it for screen readers. It renders an <h2>, as shadcn/ui's
    and Radix's do, unlike Vela's other titles, which render a <div>: a modal dialog is a page
    of its own. Phrase it as the question: "Archive 3 projects?".
*@

<DialogPrimitiveTitle class="@ClassNames.Join(Classes, Class)"
                      data-slot="dialog-title"
                      @attributes="AdditionalAttributes">
    @ChildContent
</DialogPrimitiveTitle>

@code {
    private const string Classes = "text-title text-balance text-fg";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The title text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;h2&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
