@namespace Vela.UI.Components
@* The bottom of a card, divided by a hairline: meta text in muted 12px, or buttons. *@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="card-footer"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes =
        "flex items-center gap-2 rounded-b-lg border-t px-(--card-spacing) py-3 text-caption text-fg-muted " +
        "group-data-[size=sm]/card:py-2 [&_svg:not([class*='size-'])]:size-3.5";

    /// <summary>
    /// Extra CSS classes, added after the defaults. Add <c>justify-end</c> to put
    /// buttons on the end side.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The footer's content, usually one or more Buttons.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the footer's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
