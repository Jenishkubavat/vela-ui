@namespace Vela.UI.Components
@* The main body of a card. *@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="card-content"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes = "px-(--card-spacing)";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The card's main content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the content's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
