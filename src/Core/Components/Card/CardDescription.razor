@namespace Vela.UI.Components
@* Supporting text under a CardTitle, in a muted color. *@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="card-description"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes = "text-body-sm text-fg-muted";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The description text.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the description's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
