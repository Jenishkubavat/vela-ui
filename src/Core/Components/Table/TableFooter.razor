@namespace Vela.UI.Components
@*
    A Table's <tfoot>, for totals.
*@

<tfoot class="@ClassNames.Join(Classes, Class)"
       data-slot="table-footer"
       @attributes="AdditionalAttributes">
    @ChildContent
</tfoot>

@code {
    private const string Classes =
        "border-t bg-hover font-semibold [&>tr]:last:border-b-0";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The footer row.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;tfoot&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
