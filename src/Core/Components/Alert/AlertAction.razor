@namespace Vela.UI.Components
@*
    A button pinned to the alert's top end corner, such as Undo or Dismiss.
    The alert keeps room for it automatically.
*@

<div class="@ClassNames.Join(Classes, Class)"
     data-slot="alert-action"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    private const string Classes = "absolute top-2 end-2";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The action, usually a small Button.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the action's <c>&lt;div&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
