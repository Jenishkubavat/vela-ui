@namespace Vela.UI.Components
@using Vela.UI.Primitives
@*
    Tells the components inside it which way text reads, so keyboard navigation follows
    it: in right-to-left layouts the Left arrow means "next". It passes Direction to
    DirectionPrimitive, which the keyboard primitives read. It renders no element of its
    own, so also set dir="rtl" on <html> (or a wrapper) for the browser and for
    Tailwind's rtl: variants.
*@

<DirectionPrimitive Direction="Direction">
    @ChildContent
</DirectionPrimitive>

@code {
    /// <summary>
    /// The reading direction. Defaults to <see cref="TextDirection.LeftToRight"/>.
    /// </summary>
    [Parameter]
    public TextDirection Direction { get; set; } = TextDirection.LeftToRight;

    /// <summary>
    /// The part of the app that reads in this direction.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
