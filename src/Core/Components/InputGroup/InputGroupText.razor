@namespace Vela.UI.Components
@*
    Muted text inside an InputGroupAddon, such as a currency, unit, or domain.
*@

<span class="@ClassNames.Join(Classes, Class)"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    private const string Classes =
        "flex items-center gap-2 text-body-sm text-fg-muted " +
        "[&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4";

    /// <summary>
    /// Extra CSS classes, added after the defaults.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The text, and an optional icon.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Other attributes applied to the <c>&lt;span&gt;</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
