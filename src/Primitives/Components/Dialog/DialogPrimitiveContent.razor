@namespace Vela.UI.Primitives
@implements IAsyncDisposable

<dialog @ref="_dialog"
        @attributes="AdditionalAttributes"
        id="@Root.ContentId"
        aria-labelledby="@Root.TitleId"
        aria-describedby="@(Root.HasDescription ? Root.DescriptionId : null)"
        data-state="@Root.State"
        @onclose="OnCloseAsync">
    @ChildContent
</dialog>
