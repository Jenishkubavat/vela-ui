<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Headless behavior (focus, keyboard navigation, ARIA, open/close state) with no
    styles, in the role Radix plays for shadcn/ui. Unlike src/Core, this ships as a
    NuGet package so behavior fixes reach users through updates.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Vela.UI.Primitives</PackageId>
    <Description>Unstyled, accessible behavior for Blazor components: focus management, keyboard navigation, ARIA, and open/close state. Used by Vela UI components, and usable on its own with any CSS.</Description>
    <PackageTags>blazor;components;headless;accessibility;a11y</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
