<Project>

  <!-- Single source of truth for the version. Bump it here and add a CHANGELOG entry. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- Only projects that ship as NuGet packages set IsPackable to true. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Jenish Kubavat</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Jenishkubavat/vela-ui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jenishkubavat/vela-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

</Project>
