<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Keyboard and focus tests in a real browser (Chromium, through Playwright), against the
    examples app. After building, install the browser once:

      pwsh tests/Browser/bin/Debug/net10.0/playwright.ps1 install chromium
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\examples\Demo\Vela.UI.Demo.csproj" />
  </ItemGroup>

</Project>
