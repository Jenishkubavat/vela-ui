@page "/checkbox"
@rendermode InteractiveServer

<PageTitle>Checkbox · Vela UI</PageTitle>

@* data-interactive appears once Blazor is running here, so tests know key presses will be handled. *@
<div class="flex max-w-3xl flex-col gap-10" data-interactive="@RendererInfo.IsInteractive">
    <header class="flex flex-col gap-2">
        <h1 class="text-title text-fg">Checkbox</h1>
        <p class="text-body text-fg-muted">
            A native checkbox under a styled box, so Space toggles it, clicking its label toggles it,
            and it posts with a form even without JavaScript.
        </p>
    </header>

    <Example Title="Minimal">
        <div class="flex items-center gap-2">
            <Checkbox id="terms" @bind-Value="acceptedTerms" />
            <Label For="terms">Accept the terms</Label>
        </div>
        <p class="mt-3 text-body-sm text-fg-muted" id="terms-state">@(acceptedTerms ? "Terms accepted." : "Terms not accepted.")</p>
    </Example>

    <Example Title="Realistic" Description="A list with a select-all box that shows a dash when only some items are checked.">
        <div class="flex max-w-sm flex-col gap-3">
            <div class="flex items-center gap-2">
                <Checkbox id="all-tasks"
                          Value="@AllDone"
                          Indeterminate="@SomeDone"
                          ValueChanged="SetAll"
                          ValueExpression="() => AllDone" />
                <Label For="all-tasks">All tasks</Label>
            </div>
            <Separator />
            @foreach (var task in tasks)
            {
                <div class="flex items-center gap-2 ps-6">
                    <Checkbox id="@task.Id" @bind-Value="task.Done" />
                    <Label For="@task.Id">@task.Name</Label>
                </div>
            }
            <p class="text-body-sm text-fg-muted" id="tasks-state">@tasks.Count(task => task.Done) of @tasks.Count done</p>
        </div>
    </Example>
</div>

@code {
    private sealed class TaskItem(string id, string name, bool done)
    {
        public string Id { get; } = id;

        public string Name { get; } = name;

        public bool Done { get; set; } = done;
    }

    private readonly List<TaskItem> tasks =
    [
        new("task-copy", "Write the release notes", true),
        new("task-review", "Review the pull request", false),
        new("task-ship", "Ship the build", false),
    ];

    private bool acceptedTerms;

    private bool AllDone => tasks.All(task => task.Done);

    private bool SomeDone => tasks.Any(task => task.Done) && !AllDone;

    private void SetAll(bool done)
    {
        foreach (var task in tasks)
        {
            task.Done = done;
        }
    }
}
