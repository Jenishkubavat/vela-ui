@page "/"

<PageTitle>Vela UI</PageTitle>

<div class="flex max-w-3xl flex-col gap-10">
    <header class="flex flex-col gap-2">
        <h1 class="text-title text-fg">Vela UI</h1>
        <p class="text-body text-fg-muted">
            Components for Blazor that you copy into your app as source. Start with the guide, then
            each component's page shows it in use, the command that installs it, its parameters,
            and how it behaves with a keyboard and a screen reader.
        </p>
    </header>

    @foreach (var (heading, pages) in Groups)
    {
        <section class="flex flex-col gap-3" aria-labelledby="@($"home-{heading.ToLowerInvariant()}")">
            <h2 id="@($"home-{heading.ToLowerInvariant()}")" class="text-title-sm text-fg">@heading</h2>
            <ItemGroup>
                @foreach (var entry in pages)
                {
                    <a href="@entry.Href" class="@Item.GetClasses(ItemVariant.Outline)" role="listitem">
                        <ItemContent>
                            <ItemTitle>@entry.Name</ItemTitle>
                            <ItemDescription>@entry.Description</ItemDescription>
                        </ItemContent>
                    </a>
                }
            </ItemGroup>
        </section>
    }
</div>

@code {
    private static readonly (string Heading, SitePage[] Pages)[] Groups =
    [
        ("Guides", SitePages.Guides),
        ("Components", SitePages.Components),
    ];
}
