@page "/switch"
@rendermode InteractiveServer

<PageTitle>Switch · Vela UI</PageTitle>

@* data-interactive appears once Blazor is running here, so tests know key presses will be handled. *@
<div class="flex max-w-3xl flex-col gap-10" data-interactive="@RendererInfo.IsInteractive">
    <header class="flex flex-col gap-2">
        <h1 class="text-title text-fg">Switch</h1>
        <p class="text-body text-fg-muted">
            A native checkbox with <code>role="switch"</code>, for a setting that takes effect at once.
            Screen readers announce it as on or off, and Space flips it.
        </p>
    </header>

    <Example Title="Minimal">
        <div class="flex items-center gap-2">
            <Switch id="airplane" @bind-Value="airplaneMode" />
            <Label For="airplane">Airplane mode</Label>
        </div>
    </Example>

    <Example Title="Realistic" Description="A setting that changes something on the page as soon as it's flipped.">
        <div class="flex max-w-md items-start justify-between gap-6">
            <div class="flex flex-col gap-1">
                <Label For="compact">Compact rows</Label>
                <p id="compact-hint" class="text-body-sm text-fg-muted">Fit more rows on screen by tightening the spacing.</p>
            </div>
            <Switch id="compact" aria-describedby="compact-hint" @bind-Value="compactRows" />
        </div>
        <p role="status" class="mt-4 text-body-sm text-fg-muted">Rows are @(compactRows ? "compact" : "comfortable").</p>
    </Example>
</div>

@code {
    private bool airplaneMode;
    private bool compactRows;
}
