@page "/button"

<PageTitle>Button · Vela UI</PageTitle>

<div class="flex max-w-3xl flex-col gap-10">
    <header class="flex flex-col gap-2">
        <h1 class="text-title text-fg">Button</h1>
        <p class="text-body text-fg-muted">
            A native button. Only the default variant uses the flame, so keep one per view for the
            main action.
        </p>
    </header>

    <Example Title="Minimal">
        <Button>Save</Button>
    </Example>

    <Example Title="Realistic" Description="An editor's toolbar: one primary action, quieter alternatives, a destructive action set apart, and a save in progress.">
        <div class="flex flex-col gap-6">
            <div class="flex flex-wrap items-center gap-2">
                <Button>Publish</Button>
                <Button Variant="ButtonVariant.Outline">Preview</Button>
                <Button Variant="ButtonVariant.Ghost">Discard draft</Button>
                <Button Variant="ButtonVariant.Destructive" Class="ms-auto">Delete</Button>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <Button Variant="ButtonVariant.Secondary" Disabled="true">
                    <Spinner data-icon="inline-start" />
                    Saving
                </Button>
                <Button Variant="ButtonVariant.Secondary">
                    Search
                    <Kbd>/</Kbd>
                </Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Add a section">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                </Button>
                <a href="card" class="@Button.GetClasses(ButtonVariant.Link)">See the card examples</a>
            </div>
        </div>
    </Example>

    <Install Name="button" />

    <ApiReference Types="@(new[] { typeof(Button) })" />

    <DocSection Title="Style a link as a button">
        <p>
            <code>Button.GetClasses</code> returns the button's classes for an element that has to stay
            something else, such as a link. It's the Blazor counterpart of shadcn/ui's <code>asChild</code>.
        </p>
        <CodeBlock Code="@LinkExample" />
    </DocSection>

    <DocSection Title="Keyboard and accessibility">
        <ul>
            <li>It's a native <code>&lt;button&gt;</code>, so Enter and Space activate it.</li>
            <li>
                <code>Type</code> defaults to <code>button</code>, so it doesn't submit a form unless you set
                <code>Type="submit"</code>.
            </li>
            <li><code>Disabled</code> sets the native attribute: the button can't be focused or clicked.</li>
            <li>An icon-only button needs an <code>aria-label</code>; mark its icon <code>aria-hidden="true"</code>.</li>
        </ul>
    </DocSection>

    <DocSection Title="Render modes">
        <p>
            It renders under static server rendering. <code>OnClick</code> needs an interactive render
            mode; a <code>Type="submit"</code> button still submits a static form.
        </p>
    </DocSection>
</div>

@code {
    private const string LinkExample =
        """<a href="/pricing" class="@Button.GetClasses(ButtonVariant.Outline)">See pricing</a>""";
}
