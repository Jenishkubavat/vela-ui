@page "/dialog"
@rendermode InteractiveServer

<PageTitle>Dialog · Vela UI</PageTitle>

@* data-interactive appears once Blazor is running here, so tests know key presses will be handled. *@
<div class="flex max-w-3xl flex-col gap-10" data-interactive="@RendererInfo.IsInteractive">
    <header class="flex flex-col gap-2">
        <h1 class="text-title text-fg">Dialog</h1>
        <p class="text-body text-fg-muted">
            A modal dialog for a decision. The page behind becomes inert, Escape or a click on the
            backdrop closes it, and focus returns to the button that opened it. Opening needs an
            interactive render mode.
        </p>
    </header>

    <Example Title="Minimal">
        <Dialog>
            <DialogTrigger Class="@Button.GetClasses(ButtonVariant.Outline)">Edit profile</DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Edit profile</DialogTitle>
                    <DialogDescription>Change how your name appears to your team.</DialogDescription>
                </DialogHeader>
                <Field>
                    <FieldLabel for="profile-name">Name</FieldLabel>
                    <Input id="profile-name" @bind-Value="profileName" />
                </Field>
            </DialogContent>
        </Dialog>
    </Example>

    <Example Title="The page behind" Description="While a dialog is open, the rest of the page is inert. Open the profile dialog above, then click where this button is: the click only closes the dialog, and the count stays the same.">
        <div class="flex items-center gap-3">
            <Button Variant="ButtonVariant.Outline" OnClick="() => pageClicks++">Count a click</Button>
            <span id="page-clicks" class="text-body-sm text-fg-muted">Clicked @pageClicks times</span>
        </div>
    </Example>

    <Example Title="Realistic" Description="A confirmation that can't be undone in place. Ctrl+Enter confirms, as the footer's keys say.">
        <div class="flex flex-col items-start gap-3">
            <Dialog @bind-Open="archiveOpen">
                <DialogTrigger Class="@Button.GetClasses(ButtonVariant.Outline)">Archive projects</DialogTrigger>
                <DialogContent OnConfirm="Archive">
                    <DialogHeader>
                        <DialogTitle>Archive 3 projects?</DialogTitle>
                        <DialogDescription>
                            They move out of your project list and stop syncing. You can restore them from
                            Settings for 30 days.
                        </DialogDescription>
                    </DialogHeader>
                    <DialogFooter>
                        <DialogClose Class="@Button.GetClasses(ButtonVariant.Outline)">Cancel</DialogClose>
                        <Button OnClick="Archive">Archive</Button>
                    </DialogFooter>
                </DialogContent>
            </Dialog>
            <p role="status" class="text-body-sm text-fg-muted">@(archived ? "Archived 3 projects." : "Nothing archived yet.")</p>
        </div>
    </Example>

    <Example Title="Long content" Description="A dialog taller than the window scrolls inside itself, and the page behind doesn't.">
        <Dialog>
            <DialogTrigger Class="@Button.GetClasses(ButtonVariant.Outline)">Read the terms</DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Terms of service</DialogTitle>
                    <DialogDescription>Last updated in October.</DialogDescription>
                </DialogHeader>
                @for (var section = 1; section <= 30; section++)
                {
                    <p class="text-body text-fg-muted">
                        Section @section. You keep ownership of everything you upload. We store it so we can
                        show it back to you and to the people you share it with, and for no other purpose.
                    </p>
                }
                <DialogFooter ShowCloseButton="true" />
            </DialogContent>
        </Dialog>
    </Example>

    <Install Name="dialog" Uses="Button and Kbd" Primitive="DialogPrimitive" />

    <ApiReference Types="@(new[] { typeof(Dialog), typeof(DialogTrigger), typeof(DialogContent), typeof(DialogHeader), typeof(DialogTitle), typeof(DialogDescription), typeof(DialogFooter), typeof(DialogClose) })" />

    <DocSection Title="Keyboard and accessibility">
        <ul>
            <li>
                When it opens, focus moves to the first element marked <code>autofocus</code>, or else to the
                first focusable element (some browsers focus the dialog itself). The close button comes last,
                so focus doesn't start on it.
            </li>
            <li>
                The page behind is inert: it can't be focused, clicked, or read by screen readers. Tab moves
                through the dialog and never reaches the page.
            </li>
            <li>Escape closes it, and focus returns to the trigger.</li>
            <li>
                A click on the backdrop closes it, but only when the press started on the backdrop too, so
                selecting text and dragging out doesn't, and the click never reaches the page underneath.
                Set <code>CloseOnClickOutside="false"</code> for a dialog that needs an answer.
            </li>
            <li>With <code>OnConfirm</code> set, Ctrl+Enter (&#8984;+Enter on a Mac) confirms, and the footer shows the keys.</li>
            <li>It's named by its <code>DialogTitle</code> and described by its <code>DialogDescription</code>. Always give it a title.</li>
        </ul>
    </DocSection>

    <DocSection Title="Render modes">
        <p>
            Opening and closing need an interactive render mode; under static server rendering it stays
            closed. The small script it uses, <code>dialog.js</code>, comes with the
            <code>Vela.UI.Primitives</code> package and loads by itself once the page is interactive.
        </p>
    </DocSection>

    <DocSection Title="Notes">
        <ul>
            <li>
                Unlike shadcn/ui, there are no <code>DialogPortal</code> or <code>DialogOverlay</code> parts. The
                dialog sits in the browser's top layer, and the backdrop is its <code>::backdrop</code>:
                restyle it with <code>backdrop:</code> utilities in <code>DialogContent</code>'s <code>Class</code>.
            </li>
            <li><code>vela.css</code> stops the page behind from scrolling while a dialog is open.</li>
            <li>It rises into place as it opens, unless the person prefers reduced motion. It closes without animating.</li>
        </ul>
    </DocSection>
</div>

@code {
    private int pageClicks;
    private string? profileName = "Ada Lovelace";
    private bool archiveOpen;
    private bool archived;

    private void Archive()
    {
        archived = true;
        archiveOpen = false;
    }
}
